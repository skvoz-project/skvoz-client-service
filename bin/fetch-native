#!/usr/bin/env ruby
# frozen_string_literal: true
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
abort 'Usage: fetch-native LOCK DESTINATION' unless ARGV.size == 2
begin
  require_relative '../lib/skvoz/client/native_artifact'
  Skvoz::NativeArtifact.new(ARGV[0]).fetch(ARGV[1])
rescue LoadError, StandardError => error
  warn "Native artifact fetch failed: #{error.class}: #{error.message}"
  exit 1
end
