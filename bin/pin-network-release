#!/usr/bin/env ruby
# frozen_string_literal: true
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
require_relative '../lib/skvoz/client/native_artifact'
abort 'Usage: pin-network-release EXACT-TAG [LOCK]' unless ARGV.size.between?(1, 2)
begin
  lock = ARGV[1] || File.expand_path('../artifacts/network.lock.json', __dir__)
  puts JSON.pretty_generate(Skvoz::NativeArtifact.new(lock).pin_release(ARGV[0]))
rescue LoadError, StandardError => error
  warn "Network pin refresh failed: #{error.class}: #{error.message}"
  exit 1
end
